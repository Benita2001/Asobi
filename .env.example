# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# Supabase (the URL and anon key are safe for browser use with correct RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase privileged access (server only; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side Supabase configuration
SUPABASE_PROJECT_ID=
SUPABASE_JWT_SECRET=

# Observability (optional; choose and document a provider before use)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Deployment metadata (provided automatically by Vercel; listed for documentation)
VERCEL_ENV=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=

# Provider mode. Phase 5 supports live mode only; no fixture fallback is enabled.
ASOBI_AI_MODE=live
